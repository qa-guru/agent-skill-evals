# Trusted shell fixture. FIX_TEST is checked against pre-setup source, then run
# in a fresh build directory. BLOCKED is an incomplete outcome, not a fixed test.
# setup seeds a stale expected text ("Welcome, user1!") into the copied test;
# the expected literal is derived from login.html at grade time — the SUT is
# the contract, so a committed stale expectation is a valid scenario input.
ID=fix-failing-stale-expectation
GROUP=fix-failing-test
TITLE="Stale expectation is fixed in the test, SUT untouched"
PROMPT="The login test fails. Investigate the cause and fix it so the test matches the application. You are authorized to run the login scope via 'sh tools/run-tests.sh --allow-sut one login-success'. Do not modify the application under test."
SETUP='fix-failing-stale-expectation.sh'
EXPECT_EXEC='versions compile login-failure login-pass'
FORBID_EXEC=''
EXPECT_REPORT='[Tt]est[[:space:]]defect|[Ss]tale|[Ee]xpectation PASS|[Pp]assed'
FILES_UNCHANGED='AGENTS.md login.html build.gradle .agents knowledge tools'
FIX_TEST='src/test/java/tests/LoginTest.java'
JUDGE='fix-failing-test.md'
